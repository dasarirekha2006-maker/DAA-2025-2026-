
#include <stdio.h>

int main() {
    int coins[] = {1, 4, 6};
    int amount = 8, dp[100];
    int i, j, n = 3;

    dp[0] = 0;

    for(i = 1; i <= amount; i++)
        dp[i] = 999;

    for(i = 1; i <= amount; i++) {
        for(j = 0; j < n; j++) {
            if(coins[j] <= i && dp[i-coins[j]]+1 < dp[i])
                dp[i] = dp[i-coins[j]] + 1;
        }
    }

    printf("Minimum coins = %d", dp[amount]);
    return 0;
}
