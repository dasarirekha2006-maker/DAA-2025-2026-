
#include <stdio.h>

int fact(int n) {
    if(n == 0)
        return 1;
    return n * fact(n-1);
}

int main() {
    int n = 5, i, f = 1;

    // Iterative method
    for(i = 1; i <= n; i++)
        f = f * i;

    printf("Iterative Factorial = %d\n", f);

    // Recursive method
    printf("Recursive Factorial = %d", fact(n));

    return 0;
}
