
#include <stdio.h>

int main() {
    int e[5][3] = {
        {0, 1, 2}, {1, 2, 3}, {0, 2, 4},
        {1, 3, 5}, {2, 3, 6}
    };

    int p[4] = {0, 1, 2, 3};
    int i, j, t, cost = 0;

    // Sort edges by weight
    for(i = 0; i < 5; i++)
        for(j = i+1; j < 5; j++)
            if(e[i][2] > e[j][2]) {
                for(int k = 0; k < 3; k++) {
                    t = e[i][k];
                    e[i][k] = e[j][k];
                    e[j][k] = t;
                }
            }

    printf("Edges in MST:\n");

    for(i = 0; i < 5; i++) {
        int a = e[i][0], b = e[i][1];

        if(p[a] != p[b]) {
            printf("%d - %d : %d\n", a, b, e[i][2]);
            cost += e[i][2];

            int old = p[b];
            for(j = 0; j < 4; j++)
                if(p[j] == old) p[j] = p[a];
        }
    }

    printf("Minimum Cost = %d", cost);
    return 0;
}
