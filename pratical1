#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

void swap(int *a, int *b) { int t = *a; *a = *b; *b = t; }

void bubble(int a[], int n) {
    for (int i = 0; i < n - 1; i++) {
        int sw = 0;
        for (int j = 0; j < n - i - 1; j++)
            if (a[j] > a[j + 1]) { swap(&a[j], &a[j + 1]); sw = 1; }
        if (!sw) break;                     /* best case O(n) */
    }
}

void selection(int a[], int n) {
    for (int i = 0; i < n - 1; i++) {
        int m = i;
        for (int j = i + 1; j < n; j++) if (a[j] < a[m]) m = j;
        swap(&a[i], &a[m]);
    }
}

void insertion(int a[], int n) {
    for (int i = 1; i < n; i++) {
        int k = a[i], j = i - 1;
        while (j >= 0 && a[j] > k) { a[j + 1] = a[j]; j--; }
        a[j + 1] = k;
    }
}

void merge_sort(int a[], int t[], int l, int r) {
    if (l >= r) return;
    int m = (l + r) / 2, i = l, j = m + 1, k = l;
    merge_sort(a, t, l, m);
    merge_sort(a, t, m + 1, r);
    while (i <= m && j <= r) t[k++] = (a[i] <= a[j]) ? a[i++] : a[j++];
    while (i <= m) t[k++] = a[i++];
    while (j <= r) t[k++] = a[j++];
    memcpy(&a[l], &t[l], (r - l + 1) * sizeof(int));
}

void quick(int a[], int l, int r) {
    if (l >= r) return;
    swap(&a[(l + r) / 2], &a[r]);           /* middle pivot avoids worst case on sorted data */
    int p = a[r], i = l - 1;
    for (int j = l; j < r; j++) if (a[j] < p) swap(&a[++i], &a[j]);
    swap(&a[i + 1], &a[r]);
    quick(a, l, i);
    quick(a, i + 2, r);
}

int main(void) {
    int sizes[] = {1000, 5000, 20000};
    const char *names[] = {"Bubble", "Selection", "Insertion", "Merge", "Quick"};
    srand((unsigned)time(NULL));

    printf("%-10s", "n");
    for (int s = 0; s < 5; s++) printf("%12s", names[s]);
    printf("   (time in ms)\n");

    for (int z = 0; z < 3; z++) {
        int n = sizes[z];
        int *orig = malloc(n * sizeof(int)), *a = malloc(n * sizeof(int)), *t = malloc(n * sizeof(int));
        for (int i = 0; i < n; i++) orig[i] = rand() % 100000;

        printf("%-10d", n);
        for (int s = 0; s < 5; s++) {
            memcpy(a, orig, n * sizeof(int));
            clock_t st = clock();
            switch (s) {
                case 0: bubble(a, n); break;
                case 1: selection(a, n); break;
                case 2: insertion(a, n); break;
                case 3: merge_sort(a, t, 0, n - 1); break;
                case 4: quick(a, 0, n - 1); break;
            }
            printf("%12.3f", 1000.0 * (clock() - st) / CLOCKS_PER_SEC);
        }
        printf("\n");
        free(orig); free(a); free(t);
    }
    return 0;
}
